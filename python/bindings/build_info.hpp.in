#pragma once
#define GIG_PYTHON_BUILD_TYPE R"GIG(@CMAKE_BUILD_TYPE@)GIG"
#define GIG_PYTHON_CONFIG_FLAGS R"GIG(@GIG_CONFIG_FLAGS@)GIG"
#define GIG_PYTHON_TARGET_FLAGS R"GIG(@GIG_NATIVE_OPTIONS@ -std=c++20 -fPIC -fvisibility=hidden; IPO disabled)GIG"
#define GIG_PYTHON_CORE_FLAGS R"GIG(@GIG_CORE_OPTIONS@ -std=c++20 -fPIC)GIG"
